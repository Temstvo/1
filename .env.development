# ============================================
# APPI VPN - Development Environment
# ============================================

# DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appi_vpn?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appi_vpn

# REDIS
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="dev_jwt_secret_key_min_64_chars_long_replace_in_production_1234567890"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
JWT_REFRESH_SECRET="dev_refresh_secret_key_min_64_chars_long_replace_in_production_1234567890"

# APP
NODE_ENV="development"
PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"
BACKEND_URL="http://localhost:3000"

# CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003"

# SMTP (Ethereal for dev)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@appi-vpn.com"
EMAIL_PROVIDER="smtp"

# STRIPE (Test keys)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# LEMON SQUEEZY
LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
LEMON_SQUEEZY_WEBHOOK_SECRET=""

# TELEGRAM
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="appi_vpn_dev_bot"
TELEGRAM_WEBHOOK_URL=""

# CRYPTO (Cryptomus)
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""

# S3 / MINIO
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="appi-vpn"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# SENTRY
SENTRY_DSN=""

# GRAFANA
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

# MINIO
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="appi-vpn"

# MONITORING
PROMETHEUS_RETENTION="15d"
