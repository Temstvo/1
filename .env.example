# ============================================
# APPI VPN - Environment Configuration
# ============================================
# Copy this file to .env.development or .env.production
# and fill in the values.
# ============================================

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appi_vpn?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appi_vpn

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ============================================
# JWT
# ============================================
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING_64_CHARS"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING_64_CHARS"

# ============================================
# APP
# ============================================
NODE_ENV="development"
PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"
BACKEND_URL="http://localhost:3000"

# ============================================
# CORS
# ============================================
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003"

# ============================================
# SMTP / EMAIL
# ============================================
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@appi-vpn.com"
EMAIL_PROVIDER="smtp"

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_API_VERSION="2024-12-18.acacia"

# ============================================
# LEMON SQUEEZY
# ============================================
LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
LEMON_SQUEEZY_WEBHOOK_SECRET=""

# ============================================
# TELEGRAM
# ============================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="appi_vpn_bot"
TELEGRAM_WEBHOOK_URL=""

# ============================================
# CRYPTO PAYMENTS (Cryptomus)
# ============================================
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""

# ============================================
# S3 / OBJECT STORAGE
# ============================================
S3_ENDPOINT=""
S3_BUCKET="appi-vpn"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# ============================================
# SENTRY
# ============================================
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ============================================
# GRAFANA
# ============================================
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

# ============================================
# MINIO
# ============================================
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="appi-vpn"

# ============================================
# MONITORING
# ============================================
PROMETHEUS_RETENTION="30d"
