# ============================================
# APPI VPN - Production Environment
# ============================================
# IMPORTANT: Replace ALL values below before deploying!

# DATABASE
DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/appi_vpn?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=appi_vpn

# REDIS
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_64_CHARS_MIN
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING_64_CHARS_MIN

# APP
NODE_ENV="production"
PORT=3000
API_URL="https://api.appi-vpn.com"
FRONTEND_URL="https://appi-vpn.com"
ADMIN_URL="https://admin.appi-vpn.com"
BACKEND_URL="https://api.appi-vpn.com"

# CORS
CORS_ORIGINS="https://appi-vpn.com,https://admin.appi-vpn.com"

# SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@appi-vpn.com"
EMAIL_PROVIDER="smtp"

# STRIPE
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# LEMON SQUEEZY
LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
LEMON_SQUEEZY_WEBHOOK_SECRET=""

# TELEGRAM
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="appi_vpn_bot"
TELEGRAM_WEBHOOK_URL=""

# CRYPTO (Cryptomus)
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""

# S3
S3_ENDPOINT=""
S3_BUCKET="appi-vpn"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# SENTRY
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT="appi-vpn"

# GRAFANA
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MINIO
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET="appi-vpn"

# MONITORING
PROMETHEUS_RETENTION="90d"
