# Copy to .env.production (ignored by Git). Never enable sales before the pilot checks.
APP_DOMAIN=app.example.com
POSTGRES_PASSWORD=GENERATE_64_HEX_CHARACTERS
JWT_SECRET=GENERATE_A_UNIQUE_64_HEX_SECRET
JWT_REFRESH_SECRET=GENERATE_ANOTHER_UNIQUE_64_HEX_SECRET
VPN_ENCRYPTION_KEY=GENERATE_32_BYTES_BASE64
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENABLE_GUEST_ACCESS=true
ENABLE_IMPORTED_VPN_ACCESS=false
ENABLE_CHECKOUT=false
ENABLE_VPN_TRIAL=false
TRIAL_HOURS=24
TRIAL_TRAFFIC_GB=1
TRIAL_DAILY_LIMIT=50
PILOT_MODE=true
PILOT_PRICE_RUB=499
PILOT_TRAFFIC_GB=50
MARZBAN_URL=
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
MARZBAN_INBOUND_TAG=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
# Set the receipt VAT code according to your merchant configuration; do not guess it.
YOOKASSA_VAT_CODE=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
OPERATOR_NAME=
OPERATOR_DETAILS=
