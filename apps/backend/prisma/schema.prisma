// APPI VPN - Prisma Schema
// Production-ready database schema for SaaS VPN platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTH
// ============================================

enum UserRole {
  USER
  MODERATOR
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  SUSPENDED
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique
  passwordHash  String?     @map("password_hash")
  role          UserRole    @default(USER)
  status        UserStatus  @default(ACTIVE)
  emailVerified Boolean     @default(false) @map("email_verified")
  emailVerificationTokenHash String? @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  passwordResetTokenHash     String? @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret    String? @map("two_factor_secret")
  lastLoginAt        DateTime? @map("last_login_at")
  lastLoginIp        String?   @map("last_login_ip")
  loginAttempts      Int       @default(0) @map("login_attempts")
  lockedUntil        DateTime? @map("locked_until")
  referralCode       String    @unique @map("referral_code")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  profile           Profile?
  sessions          Session[]
  devices           Device[]
  subscriptions     Subscription[]
  payments          Payment[]
  invoices          Invoice[]
  vpnConfigs        VPNConfig[]
  connections       Connection[]
  trafficUsages     TrafficUsage[]
  notifications     Notification[]
  tickets           Ticket[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  securityEvents    SecurityEvent[]
  referredBy        Referral?          @relation("ReferredUser")
  ownedReferrals    Referral[]         @relation("ReferralOwner")
  coupons           Coupon[]           @relation("CouponCreator")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([referralCode])
  @@map("users")
}

model Profile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  avatar    String?
  country   String?
  language  String  @default("en")
  phone     String?
  timezone  String  @default("UTC")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ============================================
// SESSIONS & DEVICES
// ============================================

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tokenHash    String   @map("token_hash")
  ip           String
  userAgent    String?  @map("user_agent")
  deviceName   String?  @map("device_name")
  deviceType   String?  @map("device_type")
  country      String?
  city         String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([isActive])
  @@map("sessions")
}

model Device {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  platform  String
  osVersion String?  @map("os_version")
  appVersion String? @map("app_version")
  lastIP    String?  @map("last_ip")
  lastSeen  DateTime @default(now()) @map("last_seen")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections Connection[]

  @@index([userId])
  @@map("devices")
}

// ============================================
// SUBSCRIPTIONS & PLANS
// ============================================

enum SubscriptionStatus {
  PENDING
  ACTIVE
  TRIAL
  GRACE_PERIOD
  EXPIRED
  CANCELLED
  PAST_DUE
  SUSPENDED
  REFUNDED
}

model Plan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  duration        Int      // days
  trafficLimit    BigInt   @map("traffic_limit") // bytes
  deviceLimit     Int      @map("device_limit")
  protocols       String[] // allowed protocols
  regions         String[] // allowed regions
  priority        Int      @default(0)
  features        String[]
  isActive        Boolean  @default(true) @map("is_active")
  stripePriceId   String?  @map("stripe_price_id")
  lemonSqueezyId  String?  @map("lemon_squeezy_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  planId        String             @map("plan_id") @db.Uuid
  status        SubscriptionStatus @default(ACTIVE)
  startedAt     DateTime           @default(now()) @map("started_at")
  expiresAt     DateTime           @map("expires_at")
  autoRenew     Boolean            @default(true) @map("auto_renew")
  trialEndsAt   DateTime?          @map("trial_ends_at")
  cancelledAt   DateTime?          @map("cancelled_at")
  cancelReason  String?            @map("cancel_reason")
  paymentMethod String?            @map("payment_method")
  externalId    String?            @map("external_id") // stripe subscription id
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ============================================
// PAYMENTS & INVOICES
// ============================================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  LEMON_SQUEEZY
  TELEGRAM
  CRYPTOMUS
  YOOKASSA
}

model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  subscriptionId String?        @map("subscription_id") @db.Uuid
  provider      PaymentProvider
  transactionId String?         @unique @map("transaction_id")
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  status        PaymentStatus   @default(PENDING)
  description   String?
  metadata      Json?
  webhookVerified Boolean       @default(false) @map("webhook_verified")
  refundedAt    DateTime?       @map("refunded_at")
  refundAmount  Decimal?        @db.Decimal(10, 2) @map("refund_amount")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice    Invoice?

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  paymentId   String   @unique @map("payment_id") @db.Uuid
  number      String   @unique
  pdfUrl      String?  @map("pdf_url")
  subtotal    Decimal  @db.Decimal(10, 2)
  tax         Decimal  @db.Decimal(10, 2) @default(0)
  total       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  dueDate     DateTime @map("due_date")
  paidAt      DateTime? @map("paid_at")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([number])
  @@map("invoices")
}

// ============================================
// VPN & SERVERS
// ============================================

enum ServerStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  DISABLED
}

enum Protocol {
  WIREGUARD
  OPENVPN
  XRAY_REALITY
  VLESS
}

model Server {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  country     String
  city        String
  ip          String       @unique
  protocols   Protocol[]
  status      ServerStatus @default(OFFLINE)
  cpu         Float        @default(0)
  ram         Float        @default(0)
  disk        Float        @default(0)
  bandwidth   BigInt       @default(0)
  maxUsers    Int          @map("max_users") @default(1000)
  currentUsers Int         @default(0) @map("current_users")
  load        Float        @default(0)
  latency     Float        @default(0)
  packetLoss  Float        @default(0) @map("packet_loss")
  lastHealthCheck DateTime? @map("last_health_check")
  config      Json?
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  vpnConfigs   VPNConfig[]
  connections  Connection[]
  trafficUsages TrafficUsage[]

  @@index([country])
  @@index([status])
  @@map("servers")
}

model VPNConfig {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  serverId  String   @map("server_id") @db.Uuid
  protocol  Protocol
  config    Json     // encrypted VPN configuration
  publicKey String?  @map("public_key")
  privateKey String? @map("private_key") // encrypted
  ipAddress String?  @map("ip_address")
  port      Int?
  isActive  Boolean  @default(true) @map("is_active")
  lastUsed  DateTime? @map("last_used")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id])

  @@index([userId])
  @@index([serverId])
  @@map("vpn_configs")
}

model Connection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  serverId       String    @map("server_id") @db.Uuid
  deviceId       String?   @map("device_id") @db.Uuid
  protocol       Protocol
  ipAddress      String?   @map("ip_address")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  bytesReceived  BigInt    @default(0) @map("bytes_received")
  bytesSent      BigInt    @default(0) @map("bytes_sent")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server  @relation(fields: [serverId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([serverId])
  @@index([connectedAt])
  @@map("connections")
}

model TrafficUsage {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  serverId String?  @map("server_id") @db.Uuid
  download BigInt   @default(0)
  upload   BigInt   @default(0)
  date     DateTime @db.Date
  hour     Int?     // 0-23 for hourly aggregation

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id])

  @@unique([userId, serverId, date, hour])
  @@index([userId])
  @@index([date])
  @@map("traffic_usages")
}

// ============================================
// COUPONS & REFERRALS
// ============================================

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_DAYS
  UNLIMITED
}

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  maxUses     Int?       @map("max_uses")
  currentUses Int        @default(0) @map("current_uses")
  expiresAt   DateTime?  @map("expires_at")
  minAmount   Decimal?   @db.Decimal(10, 2) @map("min_amount")
  planIds     String[]   @map("plan_ids") // applicable plans
  isActive    Boolean    @default(true) @map("is_active")
  createdBy   String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")

  creator User? @relation("CouponCreator", fields: [createdBy], references: [id])

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model Referral {
  id         String  @id @default(uuid()) @db.Uuid
  ownerId    String  @map("owner_id") @db.Uuid
  userId     String  @unique @map("user_id") @db.Uuid
  commission Decimal @db.Decimal(10, 2) @default(0)
  paid       Boolean @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  owner    User @relation("ReferralOwner", fields: [ownerId], references: [id])
  referred User @relation("ReferredUser", fields: [userId], references: [id])

  @@index([ownerId])
  @@map("referrals")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  NEW_DEVICE_LOGIN
  SUSPICIOUS_LOGIN
  SERVER_MAINTENANCE
  NEW_FEATURE
  SECURITY_ALERT
  GENERAL
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// ============================================
// SUPPORT
// ============================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  subject   String
  status    TicketStatus @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  category  String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  message   String
  isStaff   Boolean  @default(false) @map("is_staff")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

// ============================================
// FREE VPN CONFIGS (synced from GitHub)
// ============================================

model VpnConfig {
  id          String   @id @default(uuid()) @db.Uuid
  protocol    String
  uri         String
  label       String
  country     String
  countryCode String   @map("country_code")
  server      String
  listType    String   @map("list_type")
  isActive    Boolean  @default(true) @map("is_active")
  lastChecked DateTime? @map("last_checked")
  latency     Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([protocol])
  @@index([country])
  @@index([listType])
  @@index([isActive])
  @@map("free_vpn_configs")
}

// ============================================
// SECURITY & AUDIT
// ============================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  country    String?
  metadata   Json?
  result     String?  // success, failure
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  PASSWORD_CHANGED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  SUSPICIOUS_ACTIVITY
  BRUTE_FORCE_DETECTED
  TOKEN_REFRESH
  SESSION_REVOKED
}

model SecurityEvent {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      SecurityEventType
  ip        String?
  userAgent String?             @map("user_agent")
  country   String?
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("security_events")
}
