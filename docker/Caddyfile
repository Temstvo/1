{$APP_DOMAIN} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000"
  request_body {
    max_size 64KB
  }
  @webhook path /api/payments/webhook/yookassa
  handle @webhook {
    reverse_proxy backend:3000
  }
  handle /healthz {
    rewrite * /api/health
    reverse_proxy backend:3000
  }
  handle {
    reverse_proxy frontend:3001
  }
}
