{
  "name": "appi-vpn",
  "version": "1.0.0",
  "private": true,
  "description": "APPI VPN - Production-ready SaaS VPN platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "deepmerge-ts": "^8.0.0",
      "browserslist": "^4.28.7",
      "multer": "^2.3.0"
    }
  }
}
