  "policy": {
    "levels": {
      "8": {
        "connIdle": 120,
        "downlinkOnly": 1,
        "handshake": 4,
        "uplinkOnly": 1
      }
    },
    "system": {
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "remarks": "🇳🇱  Нидерланды 4 — YouTube, Gemini",
  "routing": {
    "balancers": [
      {
        "fallbackTag": "proxy",
        "selector": ["proxy"],
        "strategy": {
          "settings": {
            "baselines": ["400ms", "800ms"],
            "expected": 1,
            "maxRTT": "3s",
            "tolerance": 0.25
          },
          "type": "leastLoad"
        },
        "tag": "balancer"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "domain": ["regexp:^.{250,}$", "regexp:[^.]{64,}"],
        "outboundTag": "block",
        "ruleTag": "BLOCK_MALFORMED_DOMAIN",
        "type": "field"
      },
      {
        "outboundTag": "dns-out",
        "port": 53,
        "type": "field"
      },
      {
        "domain": ["geosite:TORRENT"],
        "outboundTag": "block",
        "ruleTag": "TORRENT_BY_DOMAIN"
      },
      {
        "outboundTag": "block",
        "port": "6881-6889,51413,21413,17417,37305",
        "ruleTag": "TORRENT_BY_PORT"
      },
      {
        "balancerTag": "balancer",
        "domain": [
          "geosite:google-play",
          "geosite:github",
          "geosite:twitch-ads",
          "geosite:youtube",
          "geosite:telegram"
        ],
        "type": "field"
      },
      {
        "domain": [
          "geosite:private",
          "geosite:category-ru",
