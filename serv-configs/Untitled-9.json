      },
      {
        "outboundTag": "dns-out",
        "port": 53,
        "type": "field"
      },
      {
        "domain": ["geosite:TORRENT"],
        "outboundTag": "block",
        "ruleTag": "TORRENT_BY_DOMAIN"
      },
      {
        "outboundTag": "block",
        "port": "6881-6889,51413,21413,17417,37305",
        "ruleTag": "TORRENT_BY_PORT"
      },
      {
        "balancerTag": "balancer",
