        "strategy": {
          "settings": {
            "baselines": ["400ms", "800ms"],
            "expected": 1,
            "maxRTT": "3s",
            "tolerance": 0.25
          },
          "type": "leastLoad"
        },
        "tag": "balancer"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch",
    "rules": [
